# ==============================================================================
# YOLO Vision Studio Environment Configuration
# ==============================================================================

# Server configuration
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# YOLO model path (custom weights or pretrained like yolo11n.pt)
# Default trained model for weld defect detection:
YOLO_MODEL_PATH=models/best.pt

# Inference thresholds
CONF_THRESHOLD=0.25
IOU_THRESHOLD=0.45
IMAGE_SIZE=640

# Upload constraints (10 MB = 10485760 bytes)
MAX_CONTENT_LENGTH=10485760

# Webcam settings
WEBCAM_FRAME_WIDTH=640
WEBCAM_FPS_LIMIT=8
